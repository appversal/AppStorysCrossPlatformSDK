{
  "name": "appstorys-react-native",
  "version": "0.1.0-alpha02",
  "description": "AppStorys SDK for React Native",
  "main": "src/index",
  "source": "src/index",
  "react-native": "src/index",
  "types": "src/index",
  "files": [
    "src",
    "android",
    "ios",
    "*.podspec",
    "!android/build",
    "!android/.gradle",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "keywords": [
    "react-native",
    "android",
    "ios",
    "sdk",
    "campaigns",
    "in-app"
  ],
  "peerDependencies": {
    "lottie-react-native": ">=6.0.0",
    "react": "*",
    "react-native": ">=0.70.0",
    "react-native-fs": ">=2.20.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-video": ">=6.0.0",
    "react-native-view-shot": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "lottie-react-native": {
      "optional": true
    },
    "react-native-fs": {
      "optional": true
    },
    "react-native-video": {
      "optional": true
    },
    "react-native-view-shot": {
      "optional": true
    }
  },
  "android": {
    "sourceDir": "./android",
    "packageImportPath": "import com.appstorysreactnative.AppstorysReactNativePackage;",
    "packageInstance": "new AppstorysReactNativePackage()"
  },
  "codegenConfig": {
    "name": "AppstorysReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "author": "AppVersal <dev@appversal.com> (https://appstorys.co)",
  "license": "UNLICENSED",
  "homepage": "https://github.com/appversal/appstorys-react-native#readme",
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.57.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "lottie-react-native": "^7.3.8",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-fs": "^2.20.0",
    "react-native-safe-area-context": "^4.10.0",
    "react-native-video": "^6.19.2",
    "react-native-view-shot": "^5.1.0",
    "typescript": "^5.2.0"
  }
}
